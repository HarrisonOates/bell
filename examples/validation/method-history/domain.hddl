(define (domain d)
  (:requirements :hierarchy :method-preconditions :negative-preconditions)
  (:predicates (p) (q))
  (:task t :parameters ())
  (:method m :parameters () :task (t)
    :precondition (and (p) (q)) :subtasks (leaf))
  (:action a :parameters () :effect (p))
  (:action b :parameters () :effect (and (q) (not (p))))
  (:action reset :parameters () :effect (and (not (p)) (not (q))))
  (:action leaf :parameters ()))
