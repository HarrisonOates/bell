(define (domain d)
  (:requirements :hierarchy :typing :method-preconditions)
  (:types place)
  (:predicates (at ?x - place))
  (:task travel :parameters (?to - place))
  (:method route :parameters (?from ?to - place)
    :task (travel ?to)
    :precondition (at ?from)
    :subtasks (step (move ?from ?to)))
  (:action move :parameters (?from ?to - place)
    :precondition (at ?from)
    :effect (and (not (at ?from)) (at ?to))))
